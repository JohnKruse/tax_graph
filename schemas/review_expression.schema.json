{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_expression.schema.json",
  "title": "Review workbench semantic expression",
  "description": "A structured, human-displayable expression projected from graph rules.",
  "$ref": "#/$defs/expression",
  "$defs": {
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id"],
      "properties": {
        "object_type": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "display_label": {"type": "string"}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "input", "imported", "copy", "sum", "subtract", "negate",
            "multiply", "lookup_table", "lookup_bracket", "max", "min",
            "if_else", "cross_form_fetch", "repeatable_table", "parameter", "frontier",
            "review_gap", "literal", "reference"
          ]
        },
        "operation": {
          "enum": [
            "COPY", "SUM", "SUBTRACT", "NEGATE", "MULTIPLY",
            "LOOKUP_TABLE", "LOOKUP_BRACKET", "MAX", "MIN", "IF_ELSE", "REQUIRE_INPUT"
          ]
        },
        "label": {"type": "string"},
        "text": {"type": "string"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "ref": {"$ref": "#/$defs/object_ref"},
        "source": {"$ref": "#/$defs/expression"},
        "left": {"$ref": "#/$defs/expression"},
        "right": {"$ref": "#/$defs/expression"},
        "factor": {"$ref": "#/$defs/expression"},
        "operands": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/expression"}
        },
        "children": {
          "type": "array",
          "items": {"$ref": "#/$defs/expression"}
        },
        "branches": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "then"],
            "properties": {
              "when": {"type": "string", "minLength": 1},
              "then": {"$ref": "#/$defs/expression"}
            }
          }
        },
        "else": {"$ref": "#/$defs/expression"},
        "parameter_ref": {"type": "string", "minLength": 1},
        "lookup_ref": {"type": "string", "minLength": 1},
        "citation_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "object_refs": {
          "type": "array",
          "items": {"$ref": "#/$defs/object_ref"},
          "uniqueItems": true
        },
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tax Graph node-to-page geometry",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_year", "entries"],
  "properties": {
    "tax_year": {"type": "integer"},
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document_id", "slot", "field_name", "page", "rect"],
        "properties": {
          "document_id": {"type": "string"},
          "slot": {"type": "string"},
          "field_name": {"type": "string"},
          "node_id": {"type": "string"},
          "identity_slot": {"type": "string"},
          "runtime_fact_ref": {"type": "string"},
          "source_ref": {"type": "string"},
          "address_id": {"type": "string"},
          "label": {"type": "string", "minLength": 1},
          "population_policy": {
            "enum": ["user_entered", "imported", "copied", "computed", "decision_required", "intentionally_blank", "unsupported"]
          },
          "value_format": {"type": "string"},
          "reason": {"type": "string"},
          "downstream_effect": {"type": "string"},
          "missing_capability": {"type": "string"},
          "repeatable": {"type": "object"},
          "page": {"type": "integer", "minimum": 1},
          "rect": {
            "type": "array",
            "prefixItems": [
              {"type": "number"}, {"type": "number"}, {"type": "number"}, {"type": "number"}
            ],
            "minItems": 4,
            "maxItems": 4
          }
        },
        "anyOf": [
          {"required": ["node_id"]},
          {"required": ["identity_slot"]},
          {"required": ["runtime_fact_ref"]},
          {"required": ["source_ref"]},
          {"required": ["population_policy"]}
        ]
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Tax Graph Acquisition Manifest",
  "description": "Manifest of authoritative source documents to acquire for a tax year.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_year", "documents"],
  "properties": {
    "tax_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "kind"],
      "oneOf": [
        {
          "required": ["url"],
          "not": { "required": ["region"] }
        },
        {
          "required": ["region"],
          "not": {
            "anyOf": [
              { "required": ["url"] },
              { "required": ["expected_sha256"] }
            ]
          }
        }
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["tax_form", "instructions", "publication", "source_document", "schedule", "worksheet"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.irs\\.gov/pub/irs-(pdf|prior)/[fip][a-z0-9-]+\\.pdf$"
        },
        "region": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_document_id", "title", "parent_sha256"],
          "properties": {
            "source_document_id": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "title": { "type": "string", "minLength": 1 },
            "parent_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          },
          "description": "A title-identified region of another acquired document."
        },
        "instructions_document_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Paired instructions document to include when extracting this form or schedule."
        },
        "instruction_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.irs\\.gov/instructions/[a-z0-9]+$",
          "description": "Structured HTML instruction page for this acquired instruction document."
        },
        "expected_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Pinned source PDF sha256 for promoted-year drift detection."
        }
      }
    }
  }
}

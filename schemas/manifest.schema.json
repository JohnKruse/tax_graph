{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "manifest.schema.json",
  "title": "Tax Graph Acquisition Manifest",
  "description": "Manifest of authoritative source documents to acquire for a tax year.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_year", "documents"],
  "properties": {
    "tax_year": {
      "type": "integer",
      "minimum": 1900,
      "maximum": 2100
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "kind", "url"],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "kind": {
          "type": "string",
          "enum": ["tax_form", "instructions", "publication", "source_document", "schedule", "worksheet"]
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://www\\.irs\\.gov/pub/irs-(pdf|prior)/[fip][a-z0-9-]+\\.pdf$"
        },
        "instructions_document_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$",
          "description": "Paired instructions document to include when extracting this form or schedule."
        }
      }
    }
  }
}

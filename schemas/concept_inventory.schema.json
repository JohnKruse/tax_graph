{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "concept_inventory.schema.json",
  "title": "Tax Graph stable flow-spine concept inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "year", "document_id", "concepts"],
  "properties": {
    "schema_version": {"const": 1},
    "year": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "document_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "concepts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/concept"}}
  },
  "$defs": {
    "concept_id": {"type": "string", "pattern": "^[a-z0-9_]+(?:/[a-z0-9_]+)+$"},
    "placement": {
      "type": "object", "additionalProperties": false,
      "required": ["address_id", "concept_id", "printed_kind", "printed_token", "printed_ref"],
      "properties": {
        "address_id": {"type": "string", "minLength": 1},
        "concept_id": {"$ref": "#/$defs/concept_id"},
        "printed_kind": {"enum": ["section", "table", "line", "box"]},
        "printed_token": {"type": "string", "minLength": 1},
        "printed_ref": {"type": "string", "minLength": 1}
      }
    },
    "occurrence": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "review_granularity", "row_policy"],
      "properties": {
        "kind": {"enum": ["singleton", "entity"]},
        "entity_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "review_granularity": {"const": "concept"},
        "row_policy": {"enum": ["none", "entity_keyed"]}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "entity"}}, "required": ["kind"]},
         "then": {"required": ["entity_key"], "properties": {"row_policy": {"const": "entity_keyed"}}},
         "else": {"properties": {"row_policy": {"const": "none"}}}}
      ]
    },
    "concept": {
      "type": "object", "additionalProperties": false,
      "required": ["concept_id", "document_id", "status", "flow_path", "owner", "role",
                    "review_granularity", "occurrence", "aliases", "placements", "same_fact_as"],
      "properties": {
        "concept_id": {"$ref": "#/$defs/concept_id"},
        "document_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "status": {"enum": ["active", "retired"]},
        "retired_year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "flow_path": {"type": "array", "minItems": 3, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "owner": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "role": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "review_granularity": {"const": "concept"},
        "occurrence": {"$ref": "#/$defs/occurrence"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "placements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placement"}},
        "same_fact_as": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "retired"}}, "required": ["status"]},
         "then": {"required": ["retired_year"]}}
      ]
    }
  }
}

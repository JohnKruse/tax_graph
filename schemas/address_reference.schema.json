{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "address_reference.schema.json",
  "title": "Tax Graph canonical address reference claims", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "year", "document_id", "references"],
  "properties": {
    "schema_version": {"const": 1}, "year": {"type": "integer"}, "document_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "references": {"type": "array", "items": {"$ref": "#/$defs/reference"}}
  },
  "$defs": {"reference": {"type": "object", "additionalProperties": false, "required": ["reference_id", "source_address_id", "target_document_id", "target_official_ref", "status", "evidence_hash"], "properties": {
    "reference_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "source_address_id": {"type": "string"}, "citation_id": {"type": "string"}, "target_document_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "target_official_ref": {"type": "string", "minLength": 1}, "target_path": {"type": "array", "items": {"type": "object"}}, "control_role": {"enum": ["none", "amount", "text", "description", "checkbox", "radio", "choice", "date", "identifier", "signature", "attachment_indicator", "other"]}, "resolved_address_id": {"type": "string"}, "status": {"enum": ["exact", "provisional", "ambiguous", "unresolved"]}, "evidence_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }}}
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_address_verdict.schema.json",
  "title": "Address-keyed human review verdict",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict_id", "tax_year", "address", "content_fingerprint",
    "reviewed_content", "judgement", "reviewer_id", "reviewed_at", "reviewed_at_epoch"
  ],
  "properties": {
    "verdict_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "tax_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "address": {"type": "string", "minLength": 1},
    "content_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "reviewed_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "expression", "form_citations", "instruction_citations"],
      "properties": {
        "label": {"type": "string"},
        "expression": {"$ref": "#/$defs/expression"},
        "form_citations": {"type": "array", "items": {"type": "string"}},
        "instruction_citations": {"type": "array", "items": {"type": "string"}}
      }
    },
    "judgement": {"type": "string", "minLength": 1},
    "reviewer_id": {"type": "string", "minLength": 1},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "reviewed_at_epoch": {"type": "integer"},
    "provenance": {"type": "object", "additionalProperties": true},
    "comment": {"type": "string"}
  },
  "$defs": {
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id"],
      "properties": {
        "object_type": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "display_label": {"type": "string"}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "input", "imported", "copy", "sum", "subtract", "negate",
            "multiply", "lookup_table", "lookup_bracket", "max", "min",
            "if_else", "cross_form_fetch", "repeatable_table", "parameter", "frontier",
            "review_gap", "literal", "reference"
          ]
        },
        "operation": {"type": "string"},
        "label": {"type": "string"},
        "text": {"type": "string"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "ref": {"$ref": "#/$defs/object_ref"},
        "source": {"$ref": "#/$defs/expression"},
        "left": {"$ref": "#/$defs/expression"},
        "right": {"$ref": "#/$defs/expression"},
        "factor": {"$ref": "#/$defs/expression"},
        "operands": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
        "children": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "then"],
            "properties": {
              "when": {"type": "string", "minLength": 1},
              "then": {"$ref": "#/$defs/expression"}
            }
          }
        },
        "else": {"$ref": "#/$defs/expression"},
        "parameter_ref": {"type": "string", "minLength": 1},
        "lookup_ref": {"type": "string", "minLength": 1},
        "citation_refs": {"type": "array", "items": {"type": "string"}},
        "object_refs": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}},
        "reason": {"type": "string", "minLength": 1}
      }
    }
  }
}

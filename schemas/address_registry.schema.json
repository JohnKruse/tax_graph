{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "address_registry.schema.json",
  "title": "Tax Graph canonical address registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "year", "document_id", "addresses"],
  "properties": {
    "schema_version": {"const": 1},
    "year": {"type": "integer", "minimum": 2000, "maximum": 2100},
    "document_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "addresses": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/address"}}
  },
  "$defs": {
    "path_component": {
      "type": "object", "additionalProperties": false, "required": ["kind", "token"],
      "properties": {
        "kind": {"enum": ["document", "part", "section", "line", "item", "box", "control", "option", "table", "row_template", "column", "worksheet_step"]},
        "token": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["source_path", "source_hash"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page": {"type": "integer", "minimum": 1},
        "quoted_text": {"type": "string", "minLength": 1}
      }
    },
    "address": {
      "type": "object", "additionalProperties": false,
      "required": ["address_id", "logical_key", "year", "document_id", "parent_address_id", "kind", "path", "printed_label", "aliases", "control_role", "status", "evidence"],
      "properties": {
        "address_id": {"type": "string", "pattern": "^[0-9]{4}/[a-z0-9_.=/%-]+$"},
        "logical_key": {"type": "string", "pattern": "^[a-z0-9_.=/%-]+$"},
        "year": {"type": "integer", "minimum": 2000, "maximum": 2100},
        "document_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "parent_address_id": {"type": ["string", "null"]},
        "kind": {"enum": ["document", "part", "section", "line", "item", "box", "control", "option", "table", "row_template", "column", "worksheet_step"]},
        "path": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path_component"}},
        "official_ref": {"type": "string", "minLength": 1},
        "concept_id": {"type": "string", "pattern": "^[a-z0-9_]+(?:/[a-z0-9_]+)+$"},
        "placement": {
          "type": "object", "additionalProperties": false,
          "required": ["concept_id", "printed_kind", "printed_token", "printed_ref"],
          "properties": {
            "concept_id": {"type": "string", "pattern": "^[a-z0-9_]+(?:/[a-z0-9_]+)+$"},
            "printed_kind": {"enum": ["section", "table", "line", "box"]},
            "printed_token": {"type": "string", "minLength": 1},
            "printed_ref": {"type": "string", "minLength": 1}
          }
        },
        "occurrence": {
          "type": "object", "additionalProperties": false,
          "required": ["kind", "review_granularity", "row_policy"],
          "properties": {
            "kind": {"enum": ["singleton", "slot"]},
            "slot_key": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "axes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"enum": ["copy", "row_slot"]}
            },
            "review_granularity": {"const": "concept"},
            "row_policy": {"enum": ["none", "slot_keyed"]}
          },
          "allOf": [
            {"if": {"properties": {"kind": {"const": "slot"}}, "required": ["kind"]},
             "then": {"required": ["slot_key", "axes"], "properties": {"row_policy": {"const": "slot_keyed"}}},
             "else": {"properties": {"row_policy": {"const": "none"}}}}
          ]
        },
        "printed_label": {"type": "string"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "citation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "control_role": {"enum": ["none", "amount", "text", "description", "checkbox", "radio", "choice", "date", "identifier", "signature", "attachment_indicator", "other"]},
        "status": {"enum": ["confirmed", "pending_review", "provisional", "unresolved"]},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}}
      },
      "allOf": [
        {"if": {"required": ["concept_id"]}, "then": {"required": ["placement", "occurrence"]}},
        {"if": {"properties": {"kind": {"const": "document"}}, "required": ["kind"]}, "then": {"properties": {"parent_address_id": {"type": "null"}, "control_role": {"const": "none"}}}, "else": {"properties": {"parent_address_id": {"type": "string", "minLength": 1}}}},
        {"if": {"properties": {"kind": {"enum": ["control", "option", "column"]}}, "required": ["kind"]}, "then": {}, "else": {"properties": {"control_role": {"const": "none"}}}}
      ]
    }
  }
}

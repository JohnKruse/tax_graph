{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tax Graph AcroForm field map",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_year", "document_id", "inventory", "mappings", "excluded_nodes", "frontier_fields"],
  "properties": {
    "schema_version": {"type": "integer", "enum": [1, 2]},
    "tax_year": {"type": "integer"},
    "document_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "inventory": {"type": "string"},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["slot", "field_name"],
        "properties": {
          "slot": {"type": "string"},
          "field_name": {"type": "string"},
          "format": {"enum": ["dollars", "text", "checkbox"]},
          "checkbox_value": {"type": "string"},
          "node_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "identity_slot": {"type": "string", "pattern": "^[a-z0-9_]+$"}
          ,"address_id": {"type": "string", "pattern": "^[0-9]{4}/[a-z0-9_.=/%-]+$"}
        },
        "oneOf": [
          {"required": ["node_id"], "properties": {"node_id": {"type": "string", "pattern": "^[a-z0-9_]+$"}}},
          {"required": ["identity_slot"], "properties": {"identity_slot": {"type": "string", "pattern": "^[a-z0-9_]+$"}}}
        ]
      }
    },
    "excluded_nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["node_id", "reason"],
        "properties": {
          "node_id": {"type": "string"},
          "reason": {"type": "string", "minLength": 1},
          "optional_extension": {"type": "boolean"}
        }
      }
    },
    "frontier_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["frontier_id", "field_name", "note"],
        "properties": {
          "frontier_id": {"type": "string"},
          "field_name": {"type": "string"},
          "note": {"type": "string", "minLength": 1}
        }
      }
    },
    "field_dispositions": {
      "type": "array",
      "items": {"$ref": "#/$defs/field_disposition"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": 2}}, "required": ["schema_version"]},
      "then": {"required": ["field_dispositions"]}
    }
  ],
  "$defs": {
    "field_disposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_name", "label", "population_policy", "value_format"],
      "properties": {
        "field_name": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "population_policy": {
          "enum": [
            "user_entered", "imported", "copied", "computed",
            "decision_required", "intentionally_blank", "unsupported"
          ]
        },
        "value_format": {
          "enum": [
            "text", "dollars", "integer", "decimal", "date", "ssn", "ein",
            "checkbox", "radio", "choice", "signature", "other"
          ]
        },
        "node_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "identity_slot": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "runtime_fact_ref": {"type": "string", "pattern": "^[a-z0-9_.#]+$"},
        "source_ref": {"type": "string", "minLength": 1},
        "address_id": {"type": "string", "pattern": "^[0-9]{4}/[a-z0-9_.=/%-]+$"},
        "reason": {"type": "string", "minLength": 1},
        "downstream_effect": {"type": "string", "minLength": 1},
        "missing_capability": {"type": "string", "minLength": 1},
        "repeatable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["group", "row_slot", "column", "role"],
          "properties": {
            "group": {"type": "string", "pattern": "^[a-z0-9_]+$"},
            "row_slot": {"type": "integer", "minimum": 1},
            "column": {"type": "string", "minLength": 1},
            "role": {"enum": ["identity", "value", "decision", "description", "total", "other"]}
          }
        }
      },
      "allOf": [
        {
          "if": {"properties": {"population_policy": {"enum": ["copied", "computed"]}}, "required": ["population_policy"]},
          "then": {"required": ["node_id"]}
        },
        {
          "if": {"properties": {"population_policy": {"const": "user_entered"}}, "required": ["population_policy"]},
          "then": {"anyOf": [{"required": ["node_id"]}, {"required": ["identity_slot"]}, {"required": ["runtime_fact_ref"]}]}
        },
        {
          "if": {"properties": {"population_policy": {"const": "imported"}}, "required": ["population_policy"]},
          "then": {"anyOf": [{"required": ["node_id"]}, {"required": ["source_ref"]}]}
        },
        {
          "if": {"properties": {"population_policy": {"const": "decision_required"}}, "required": ["population_policy"]},
          "then": {"anyOf": [{"required": ["node_id"]}, {"required": ["runtime_fact_ref"]}]}
        },
        {
          "if": {"properties": {"population_policy": {"enum": ["intentionally_blank", "unsupported"]}}, "required": ["population_policy"]},
          "then": {"required": ["reason", "downstream_effect", "missing_capability"]}
        }
      ]
    }
  }
}

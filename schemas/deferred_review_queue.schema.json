{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deferred Review Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_year", "entries"],
  "properties": {
    "tax_year": {
      "type": "integer"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_id",
          "kind",
          "status",
          "priority",
          "document_id",
          "created_date",
          "created_by",
          "summary"
        ],
        "properties": {
          "queue_id": {"type": "string"},
          "kind": {"type": "string"},
          "status": {"type": "string"},
          "priority": {"type": "string"},
          "document_id": {"type": "string"},
          "source_document_id": {"type": "string"},
          "example_id": {"type": "string"},
          "created_date": {"type": "string"},
          "created_by": {"type": "string"},
          "summary": {"type": "string"},
          "artifact_dir": {"type": "string"},
          "artifact_paths": {
            "type": "array",
            "items": {"type": "string"}
          },
          "machine_agreed": {"type": "boolean"},
          "human_confirmed": {"type": "boolean"},
          "review_status": {"type": "string"},
          "changed_kinds": {
            "type": "array",
            "items": {"type": "string"}
          },
          "changed_object_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "machine_witnesses": {
            "type": "array",
            "items": {"type": "string"}
          },
          "expected_nodes": {
            "type": "array",
            "items": {"type": "string"}
          }
        }
      }
    }
  }
}

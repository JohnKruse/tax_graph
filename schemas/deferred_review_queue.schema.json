{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deferred Review Queue",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_year", "entries"],
  "properties": {
    "tax_year": {
      "type": "integer"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "queue_id",
          "kind",
          "status",
          "priority",
          "document_id",
          "created_date",
          "created_by",
          "summary"
        ],
        "properties": {
          "queue_id": {"type": "string"},
          "kind": {"type": "string"},
          "status": {"type": "string"},
          "priority": {"type": "string"},
          "document_id": {"type": "string"},
          "source_document_id": {"type": "string"},
          "example_id": {"type": "string"},
          "created_date": {"type": "string"},
          "created_by": {"type": "string"},
          "summary": {"type": "string"},
          "reason": {"type": "string"},
          "observed": {"type": "string"},
          "expected": {"type": "string"},
          "evidence": {
            "type": "array",
            "items": {"type": "string"}
          },
          "artifact_dir": {"type": "string"},
          "artifact_paths": {
            "type": "array",
            "items": {"type": "string"}
          },
          "machine_agreed": {"type": "boolean"},
          "human_confirmed": {"type": "boolean"},
          "review_status": {"type": "string"},
          "changed_kinds": {
            "type": "array",
            "items": {"type": "string"}
          },
          "changed_object_ids": {
            "type": "array",
            "items": {"type": "string"}
          },
          "machine_witnesses": {
            "type": "array",
            "items": {"type": "string"}
          },
          "expected_nodes": {
            "type": "array",
            "items": {"type": "string"}
          },
          "review_scope": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scope_version", "scope_type", "object_refs"],
            "properties": {
              "scope_version": {"const": 1},
              "scope_type": {
                "enum": [
                  "object", "field_map", "promotion", "decision", "frontier",
                  "intake", "example", "extension"
                ]
              },
              "object_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["object_type", "object_id", "source_path"],
                  "properties": {
                    "object_type": {"type": "string", "minLength": 1},
                    "object_id": {"type": "string", "minLength": 1},
                    "source_path": {"type": "string", "minLength": 1},
                    "role": {
                      "enum": ["primary", "related", "excluded", "frontier", "expected"]
                    }
                  }
                },
                "uniqueItems": true
              }
            }
          },
          "gate": {
            "type": "string",
            "enum": ["project", "user"]
          },
          "verification_tier": {"type": "string"},
          "source_hash": {"type": "string"},
          "extension_hash": {"type": "string"},
          "verdict_id": {"type": "string"},
          "verdict": {"type": "string"},
          "verdict_reason": {"type": "string"},
          "reviewer_id": {"type": "string"},
          "reviewed_at": {"type": "string"},
          "human_minutes": {"type": "number", "minimum": 0},
          "verdict_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "source_override": {"type": "object"}
          }
        }
      }
    }
  }

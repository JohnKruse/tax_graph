{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review_manifest.schema.json",
  "title": "Tax Graph review workbench manifest",
  "description": "Deterministic review projection generated from published artifacts.",
  "type": "object",
  "additionalProperties": false,
  "required": ["tax_year", "manifest_hash", "entries"],
  "properties": {
    "schema_version": {"type": "integer", "minimum": 1},
    "tax_year": {"type": "integer", "minimum": 1900, "maximum": 2100},
    "manifest_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact_ref"},
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "content_hash"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "content_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "object_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["object_type", "object_id"],
      "properties": {
        "object_type": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "artifact_path": {"type": "string", "minLength": 1},
        "display_label": {"type": "string"}
      }
    },
    "rect": {
      "type": "array",
      "prefixItems": [
        {"type": "number"}, {"type": "number"},
        {"type": "number"}, {"type": "number"}
      ],
      "minItems": 4,
      "maxItems": 4
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["document_id", "source_pdf_hash", "page", "rect"],
      "properties": {
        "document_id": {"type": "string", "minLength": 1},
        "source_pdf_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "page": {"type": "integer", "minimum": 1},
        "rect": {"$ref": "#/$defs/rect"},
        "locator_text": {"type": "string"}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["page", "anchor_rect", "lane", "display_order"],
      "properties": {
        "page": {"type": "integer", "minimum": 1},
        "anchor_rect": {"$ref": "#/$defs/rect"},
        "lane": {"type": "integer", "minimum": 0},
        "display_order": {"type": "integer", "minimum": 0}
      }
    },
    "source_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "object_type", "object_id"],
      "properties": {
        "direction": {"enum": ["source", "target"]},
        "object_type": {"type": "string", "minLength": 1},
        "object_id": {"type": "string", "minLength": 1},
        "display_label": {"type": "string"}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state"],
      "properties": {
        "state": {"enum": ["pending", "visited", "complete", "not_applicable"]},
        "required_for_confirm": {"type": "boolean"},
        "visited_at": {"type": "string", "format": "date-time"},
        "note": {"type": "string"}
      }
    },
    "expression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": {
          "enum": [
            "input", "imported", "copy", "sum", "subtract", "negate",
            "multiply", "lookup_table", "lookup_bracket", "max", "min",
            "if_else", "repeatable_table", "parameter", "frontier",
            "review_gap", "literal", "reference"
          ]
        },
        "operation": {"type": "string"},
        "label": {"type": "string"},
        "text": {"type": "string"},
        "value": {"type": ["string", "number", "boolean", "null"]},
        "ref": {"$ref": "#/$defs/object_ref"},
        "source": {"$ref": "#/$defs/expression"},
        "left": {"$ref": "#/$defs/expression"},
        "right": {"$ref": "#/$defs/expression"},
        "factor": {"$ref": "#/$defs/expression"},
        "operands": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
        "children": {"type": "array", "items": {"$ref": "#/$defs/expression"}},
        "branches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "then"],
            "properties": {
              "when": {"type": "string", "minLength": 1},
              "then": {"$ref": "#/$defs/expression"}
            }
          }
        },
        "else": {"$ref": "#/$defs/expression"},
        "parameter_ref": {"type": "string", "minLength": 1},
        "lookup_ref": {"type": "string", "minLength": 1},
        "citation_refs": {"type": "array", "items": {"type": "string"}},
        "object_refs": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "queue_id", "unit_id", "review_kind", "required", "object_refs",
        "official_location", "analog_placement", "semantic_class", "summary",
        "expression", "coverage"
      ],
      "properties": {
        "queue_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "unit_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "review_kind": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "object_refs": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}},
        "official_location": {"oneOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]},
        "analog_placement": {"oneOf": [{"$ref": "#/$defs/placement"}, {"type": "null"}]},
        "semantic_class": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "expression": {"$ref": "#/$defs/expression"},
        "source_refs": {"type": "array", "items": {"$ref": "#/$defs/source_ref"}},
        "citation_refs": {"type": "array", "items": {"type": "string"}},
        "witness_refs": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "trust": {"type": "string"},
        "nversion_refs": {"type": "array", "items": {"type": "string"}},
        "promotion_diff_refs": {"type": "array", "items": {"type": "string"}},
        "coverage": {"$ref": "#/$defs/coverage"}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["queue_id", "review_kind", "status", "units"],
      "properties": {
        "queue_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "review_kind": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "summary": {"type": "string"},
        "units": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/unit"}}
      }
    }
  }
}
